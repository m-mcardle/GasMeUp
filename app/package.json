{
  "name": "gas-me-up",
  "version": "1.1.2",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev": "expo start --dev-client",
    "start:prod": "expo start --no-dev",
    "client": "expo start",
    "server": "cd server && npm run start-full",
    "android": "FIREBASE_ENV=dev expo run:android",
    "ios": "FIREBASE_ENV=dev expo run:ios",
    "build": "eas build",
    "build:dev": "eas build --profile development",
    "build:devlocal": "eas build --profile development --platform ios --local",
    "build:sim": "eas build --profile simulator --platform ios",
    "bump": "standard-version",
    "bump-minor": "standard-version --release-as minor",
    "bump-major": "standard-version --release-as major",
    "publish": "eas submit --platform ios",
    "publish:expo": "eas update",
    "publish:android": "eas submit --platform android",
    "publish-functions": "firebase deploy",
    "check-types": "npx tsc",
    "push:secrets": "eas secret:push --scope project --env-file .env --force",
    "lint": "npx eslint './src/' 'App.tsx'",
    "lint:fix": "npx eslint --fix './src/' 'App.tsx'",
    "lint-client": "npx eslint './src/' 'App.tsx'",
    "install-server": "cd ../server && npm install",
    "test-server": "cd ../server && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/remote-config": "^26.4.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/stack": "^7.12.0",
    "expo": "^55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-asset": "~55.0.20",
    "expo-auth-session": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-checkbox": "~55.0.4",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.27",
    "expo-splash-screen": "~55.0.25",
    "expo-task-manager": "~55.0.20",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "firebase": "^12.19.0",
    "md5": "^2.3.0",
    "react": "19.2.0",
    "react-firebase-hooks": "^5.0.3",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-uuid": "^2.0.1",
    "throttle-debounce": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@types/md5": "^2.3.2",
    "@types/react": "~19.2.10",
    "@types/throttle-debounce": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^5.23.0",
    "@typescript-eslint/parser": "^5.23.0",
    "dotenv": "^16.6.1",
    "eslint": "^8.15.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^4.5.0",
    "eslint-plugin-react-native": "^4.0.0",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "postcss": "8.5.10",
    "expo-dev-launcher": {
      "ajv": "8.20.0"
    }
  },
  "private": true,
  "proxy": "http://localhost:3001"
}
