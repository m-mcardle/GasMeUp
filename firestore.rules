rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Transactions/{transactionID}/{documents=**} {
    	allow read: if request.auth != null
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.payeeUID || request.auth.uid == request.resource.data.payerUID || request.auth.uid in request.resource.data.payers)
    }

    match /Users/{uid}/{documents=**} {
    	allow read: if request.auth != null && (
      	uid == request.auth.uid ||
        request.auth.uid in resource.data.friends
      )
      allow create, update, delete: if request.auth != null && uid == request.auth.uid
    }

		match /SecureUsers/{uid}/{documents=**} {
      allow read, write, delete: if request.auth != null && uid == request.auth.uid
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
