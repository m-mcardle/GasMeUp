{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2017", "dom"],
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "moduleResolution": "node",
    "noEmit": false
  },
  "compileOnSave": true,
  "include": [
    "src",
    "index.ts",
  ]
}
