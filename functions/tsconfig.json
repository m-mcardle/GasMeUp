{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"],
    "module": "node20",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "target": "es2023",
    "noEmit": false
  },
  "compileOnSave": true,
  "include": [
    "src",
    "index.ts"
  ]
}
