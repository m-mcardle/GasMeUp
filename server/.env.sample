# Copy to .env and fill in. Every variable read by src/ is listed here.

# Google Maps Platform key. Needs Geocoding API plus, depending on GOOGLE_MAPS_API:
#   legacy: Places API (legacy) + Directions API
#   new:    Places API (New) + Routes API
GOOGLE_API_KEY="API_KEY"
# Optional: which Google Maps APIs back /suggestions, /place and /distance.
# `legacy` (default) or `new`. Response shapes are identical in both modes.
# GOOGLE_MAPS_API=legacy
# RapidAPI key for the canadian-gas-prices API
RAPID_API_KEY="API_KEY"
# App identifier the mobile app sends on every data route, as the `x-api-key` header
# (current builds) or the legacy `api_key` query param (older builds). It ships in the
# app bundle, so it is not a secret. Every request is rejected if this is unset.
CLIENT_API_KEY="API_KEY"

# Optional: port to listen on (App Engine sets this automatically). Defaults to 3001.
# PORT=3001
# Optional: `production` silences request logging; `test` stops the server listening.
# NODE_ENV=development
